{
    "tasks": {
        "test": "deno test --allow-all tests/",
        "start": "deno run --allow-all main.js",
        "check": "deno check main.js && deno lint && deno fmt --check"
    },
    "lint": {
        "rules": {
            // this project deliberately pins versions inline instead of keeping an import map
            "exclude": ["no-import-prefix"]
        }
    },
    "fmt": {
        "useTabs": false,
        "indentWidth": 4,
        "semiColons": false,
        "lineWidth": 110
    },
    "lock": false
}
